# ─── GCP / BigQuery ───────────────────────────────────────────────────────────

# ID del proyecto de GCP donde viven los datasets de dbt
GCP_PROJECT=xxxx

# Región de BigQuery
GCP_LOCATION=us-central1

# ─── Autenticación ────────────────────────────────────────────────────────────

# Opción A — Application Default Credentials (desarrollo local con gcloud)
# Correr: gcloud auth application-default login
# No requiere variable adicional.

# Opción B — Service Account (CI / Cloud Build / producción)
# Ruta al archivo .json de la service account con permisos BigQuery
GOOGLE_APPLICATION_CREDENTIALS=/ruta/al/keyfile.json

# ─── dbt ──────────────────────────────────────────────────────────────────────

# profiles.yml vive en dbt/profiles.yml (gitignoreado).
# Copiar dbt/profiles.yml.example como base y completar según el método de auth elegido.
# El dataset de destino se define por capa en dbt_project.yml — no sobreescribir aquí.
